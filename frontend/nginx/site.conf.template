# Public site and operator console are separate listeners with separate document
# roots. The public root contains no admin asset and the public listener proxies
# no admin route, so the two cannot be exposed by one mistake: reaching the
# console requires reaching a different port that no ingress publishes.
#
# `${CHAT_BACKEND_ORIGIN}` and `${CHAT_ADMIN_ORIGIN}` are substituted at
# container start by frontend/nginx/entrypoint.sh.

server {
    listen 8080;
    server_name _;
    root /srv/public;
    index index.html;

    add_header Cache-Control $asset_cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    # `unsafe-inline` covers styles only: the widget writes its shadow-root
    # stylesheet as a <style> element (frontend/public/widget/widget.js), which
    # CSP treats as inline however the element was created.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    # A turn that calls tools runs several model round trips; cutting it short
    # would drop a reply the backend has already committed to the transcript.
    proxy_read_timeout 180s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The visitor API surface, mirroring `_PUBLIC_GET_PATHS` and
    # `_PUBLIC_POST_PATHS` in server.py. Exact matches only, so a new backend
    # route is unreachable from the internet until it is listed here.
    location = /api/tenants {
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    location = /api/chat {
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    location = /api/chat/session {
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    location = /api/book {
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    location /api/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}

# No ingress publishes this listener; reaching it means a port-forward or an
# explicitly allowed in-cluster caller. Authentication in front of the console
# is SEC-001, and belongs on the backend rather than here.
server {
    listen 8081;
    server_name _;
    root /srv/admin;
    index admin.html;

    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 60s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/admin/ {
        proxy_pass ${CHAT_ADMIN_ORIGIN};
    }

    location = /api/leads {
        proxy_pass ${CHAT_ADMIN_ORIGIN};
    }

    location /api/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
