# Single-origin gateway: one public listener, one browser origin.
#
# The public frontend is served from /srv/public.  Admin pages live under
# /admin/ from a physically separate /srv/admin root.  Admin/API routes proxy
# to the Python admin listener; visitor API routes proxy to the Python public
# listener.  Unknown API paths fail closed (404 at the edge).
#
# Authentication uses an oauth2-proxy-style sidecar reachable via
# ${AUTH_PROXY_ORIGIN}.  The `auth_request` directive checks every protected
# location; browser page requests that fail auth are redirected to the proxy
# login flow, while API requests receive a plain 401.  The proxy injects
# X-Auth-Request identity headers. auth_request_set captures them for the
# parent request, nginx maps provider groups to application roles, and the
# resulting identity is forwarded to Python with a shared internal gateway
# token. Any client-supplied copies are overwritten. Python re-checks the
# gateway token and role independently.
#
# `${CHAT_BACKEND_ORIGIN}` (visitor API) and `${CHAT_ADMIN_ORIGIN}` (admin API)
# are substituted at container start by frontend/nginx/entrypoint.sh.
# `${AUTH_PROXY_ORIGIN}` is the oauth2-proxy internal endpoint. Browser-facing
# OAuth paths stay relative to this gateway so internal Kubernetes DNS names
# never appear in redirects.

# ---------------------------------------------------------------------------
# Widget CORS: tightly allowlisted origins for cross-origin embed calls.
# Never `*`; never includes admin origins.  Credential-free requests only.
# The map entries are generated at container start from WIDGET_ALLOWED_ORIGINS.
# ---------------------------------------------------------------------------
# TLS terminates at the trusted ingress controller in Kubernetes. Preserve its
# browser-facing scheme and host for OAuth redirects; direct Docker/dev traffic
# has no forwarded headers and falls back to nginx's own request values.
map $http_x_forwarded_proto $gateway_scheme {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

map $http_x_forwarded_host $gateway_host {
    default $http_x_forwarded_host;
    ""      $http_host;
}

# ---------------------------------------------------------------------------
# Server: single public listener
# ---------------------------------------------------------------------------
server {
    listen 8080;
    server_name _;

    # --- Security headers (applied to all responses) ------------------------
    add_header Cache-Control $asset_cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    # `unsafe-inline` covers styles only: the widget writes its shadow-root
    # stylesheet as a <style> element.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;

    # --- Proxy defaults -----------------------------------------------------
    proxy_http_version 1.1;
    proxy_set_header Host $gateway_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $gateway_scheme;
    proxy_set_header X-Request-Id $request_id;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    # A turn that calls tools runs several model round trips.
    proxy_read_timeout 180s;

    # --- Auth subrequest location (oauth2-proxy /oauth2/auth) ---------------
    # auth_request calls this internal location.  The proxy validates the
    # session cookie and returns 202 with identity headers, or 401.
    location = /_auth {
        internal;
        proxy_pass ${AUTH_PROXY_ORIGIN}/oauth2/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $gateway_host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-URL $gateway_scheme://$gateway_host$request_uri;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_scheme;
    }

    # --- Login redirect for browser requests (HTML clients) -----------------
    location @auth_login {
        return 302 $gateway_scheme://$gateway_host/oauth2/start?rd=$gateway_scheme://$gateway_host$request_uri;
    }

    # --- API 401 handler (no redirect for API clients) -----------------------
    location @api_unauthorized {
        default_type application/json;
        return 401 '{"error":"unauthorized"}';
    }

    # --- Health check --------------------------------------------------------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # --- Visitor API: proxy to Python public listener ------------------------
    # Exact matches mirror the API's visitor routes one-to-one.  Path-parameter
    # routes use regex locations narrowed to the shapes the API accepts (a slug
    # tenant ID), so a newly similar backend path cannot be published by
    # accident.  A new backend route is unreachable from the internet until it
    # is listed here.  `tests/test_web_gateway.py` asserts this location list
    # equals the API's visitor surface exactly.
    location = /api/tenants {
        if ($request_method = OPTIONS) {
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $widget_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $widget_cors_origin always;
        add_header Vary Origin always;
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    # Tenant IDs are the API's slug shape: `^[a-z0-9][a-z0-9-]*$`, max 64.
    # Quoted because the regex quantifier braces would otherwise close the
    # location block at parse time.
    location ~ "^/api/tenants/[a-z0-9][a-z0-9-]{0,63}/availability$" {
        if ($request_method = OPTIONS) {
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $widget_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $widget_cors_origin always;
        add_header Vary Origin always;
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    location = /api/chat {
        if ($request_method = OPTIONS) {
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $widget_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, X-Visitor-Credential" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $widget_cors_origin always;
        add_header Vary Origin always;
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    location = /api/chat/session {
        if ($request_method = OPTIONS) {
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $widget_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, X-Visitor-Credential" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $widget_cors_origin always;
        add_header Vary Origin always;
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    location = /api/chat/confirmation {
        if ($request_method = OPTIONS) {
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $widget_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, X-Visitor-Credential" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $widget_cors_origin always;
        add_header Vary Origin always;
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    # The visitor's consent grant: contact-bearing actions are refused until this
    # has run, so the widget needs the same public path as the chat it unlocks.
    location = /api/chat/consent {
        if ($request_method = OPTIONS) {
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $widget_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $widget_cors_origin always;
        add_header Vary Origin always;
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    # The authorized view a citation resolves to (`RAG-005`). The chunk id the
    # widget renders is a retrieval-index document id, so the location is a
    # regex narrowed to that charset rather than an open parameter.
    location ~ "^/api/chat/sources/[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$" {
        if ($request_method = OPTIONS) {
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $widget_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, X-Visitor-Credential" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $widget_cors_origin always;
        add_header Vary Origin always;
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    location = /api/book {
        if ($request_method = OPTIONS) {
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $widget_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $widget_cors_origin always;
        add_header Vary Origin always;
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    # Visitor lead capture.  The prototype's authenticated admin read of
    # captured leads is gone; the API's POST /api/leads is a write side for
    # visitors, so it belongs to the public listener.  ("/api/admin/..." reads
    # back captured leads once SEC-001 RBAC lands.)
    location = /api/leads {
        if ($request_method = OPTIONS) {
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $widget_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $widget_cors_origin always;
        add_header Vary Origin always;
        proxy_pass ${CHAT_BACKEND_ORIGIN};
    }

    # --- Admin API: proxy to Python admin listener (auth-gated) --------------
    # Every admin API path requires authentication.  Python additionally
    # enforces role-based authorization.  Identity headers from the auth
    # subrequest are forwarded; client-supplied copies are overwritten.
    location /api/admin/ {
        auth_request /_auth;
        auth_request_set $auth_email $upstream_http_x_auth_request_email;
        auth_request_set $auth_user $upstream_http_x_auth_request_user;
        auth_request_set $auth_groups $upstream_http_x_auth_request_groups;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        error_page 401 = @api_unauthorized;
        add_header Set-Cookie $auth_cookie always;
        # Overwrite any client-supplied identity headers with the values
        # captured from the auth subrequest.  $upstream_http_* are available
        # in the parent request after auth_request completes.
        proxy_set_header X-Auth-Email $auth_email;
        proxy_set_header X-Auth-Role $auth_role;
        proxy_set_header X-Auth-Subject $auth_user;
        proxy_set_header X-TenantChat-Gateway-Token ${ADMIN_GATEWAY_TOKEN};
        proxy_pass ${CHAT_ADMIN_ORIGIN};
    }

    # Browser-visible OAuth start/callback/logout endpoints remain on the
    # gateway origin and are proxied internally to oauth2-proxy.
    location /oauth2/ {
        proxy_pass ${AUTH_PROXY_ORIGIN};
        proxy_set_header Host $gateway_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $gateway_scheme;
        proxy_set_header X-Forwarded-Host $gateway_host;
    }

    # --- Catch-all: unknown API paths fail closed ---------------------------
    location /api/ {
        return 404;
    }

    # --- Admin redirect: /admin -> /admin/ -----------------------------------
    location = /admin {
        return 302 /admin/;
    }

    # --- Admin frontend: separate document root, auth-gated -----------------
    # Browser pages under /admin/ require authentication.  A 401 redirects
    # the browser to the login flow.  Static assets (JS/CSS) under /admin/
    # are also auth-gated so an unauthenticated browser cannot load them.
    location /admin/ {
        auth_request /_auth;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        error_page 401 = @auth_login;
        add_header Set-Cookie $auth_cookie always;
        alias /srv/admin/;
        index admin.html;
        try_files $uri $uri/ /admin/admin.html;
    }

    # --- Public frontend: default root ---------------------------------------
    root /srv/public;
    index index.html;

    # The one file customer sites load cross-origin.  A module script is always
    # fetched in CORS mode, so without an allowlisted origin here an embed on an
    # approved customer domain fails before it runs.  The build makes embed.js
    # self-contained precisely so this is the only asset that needs the header.
    location = /embed.js {
        if ($request_method = OPTIONS) {
            add_header Vary Origin always;
            add_header Access-Control-Allow-Origin $widget_cors_origin always;
            add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $widget_cors_origin always;
        add_header Vary Origin always;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
