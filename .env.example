# Local development configuration.
#
# Copy to `.env` (which is gitignored) and adjust:
#
#     make setup
#
# SEC-005: this file contains placeholders only. Real credentials never enter the
# repository, and no service falls back to a baked-in default for a secret — a
# missing required value must fail loudly at startup rather than silently running
# with a well-known password.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=tenantchat
POSTGRES_USER=tenantchat
# Placeholder only. Replace it with output from: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tenantchat:REPLACE_WITH_GENERATED_POSTGRES_PASSWORD@localhost:5432/tenantchat
# Alembic alone reads this schema-owner URL. Local development may use the same
# login as DATABASE_URL; deployments must use distinct owner and application
# roles as documented in docs/runbooks/database-migrations.md.
DATABASE_MIGRATION_URL=postgresql+psycopg://tenantchat:REPLACE_WITH_GENERATED_POSTGRES_PASSWORD@localhost:5432/tenantchat

# ---------------------------------------------------------------------------
# Elasticsearch
# ---------------------------------------------------------------------------
# Security stays enabled locally (with TLS off for plain HTTP) so the retrieval
# code exercises the same authentication path it uses in Kubernetes. Running
# with `xpack.security.enabled=false` locally would leave that path untested.
ELASTICSEARCH_URL=http://localhost:9200
ES_USERNAME=elastic
# Placeholder only. Replace it with output from: openssl rand -hex 24
ES_PASSWORD=REPLACE_WITH_GENERATED_ELASTICSEARCH_PASSWORD
ELASTICSEARCH_PORT=9200
KNOWLEDGE_INDEX=tenant-knowledge-chunks

# ---------------------------------------------------------------------------
# Embedding service
# ---------------------------------------------------------------------------
EMBEDDING_URL=http://localhost:8001
EMBEDDING_PORT=8001
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Exact public Hub commit for the reviewed model files. The service also passes
# trust_remote_code=False; transformers 5.14.1 supports Qwen3 natively.
EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------
# Defaults to a local OpenAI-compatible server (LM Studio, Ollama, llama.cpp).
# ADR-0002 records why the demo targets a local provider: eval suites run
# hundreds of times during development and hosted inference would meter each one.
# A hosted provider is a configuration change, not a code change.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model
# An empty value is allowed in APP_ENV=local when the provider does not
# authenticate; APP_ENV=production rejects it and requires a real provider key.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# Internal service authentication
# ---------------------------------------------------------------------------
# These four placeholders are independent credentials. Generate a different
# value for each with: openssl rand -hex 32
CHAT_TO_FINANCING_TOKEN=REPLACE_WITH_GENERATED_CHAT_TO_FINANCING_TOKEN
SEED_TO_INGESTION_TOKEN=REPLACE_WITH_GENERATED_SEED_TO_INGESTION_TOKEN
INGESTION_TO_EMBEDDING_TOKEN=REPLACE_WITH_GENERATED_INGESTION_TO_EMBEDDING_TOKEN
FINANCING_TO_EMBEDDING_TOKEN=REPLACE_WITH_GENERATED_FINANCING_TO_EMBEDDING_TOKEN

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# `make dev` runs Vite with hot reload and proxies /api to this backend, so the
# browser stays same-origin exactly as it is behind nginx. Point it at
# http://127.0.0.1:8080 to develop against services/api instead.
CHAT_DEV_BACKEND_ORIGIN=http://127.0.0.1:8000
CHAT_DEV_ADMIN_ORIGIN=http://127.0.0.1:8000
CHAT_DEV_PORT=5173
# `make web` runs the deployed nginx image against a backend on the host.
# Kubernetes splits these across the public (8000) and admin (8004) listeners;
# outside APP_ENV=production the prototype serves both on one port.
CHAT_BACKEND_ORIGIN=http://host.docker.internal:8000
CHAT_ADMIN_ORIGIN=http://host.docker.internal:8000
# In compose there is no oauth2-proxy; point at the dev backend. In Kubernetes
# this is the oauth2-proxy Service.
AUTH_PROXY_ORIGIN=http://host.docker.internal:8000
WEB_PORT=8080

# ---------------------------------------------------------------------------
# Gateway authentication (SEC-001 single-origin gateway)
# ---------------------------------------------------------------------------
# The nginx gateway auth-gates /admin/ and /api/admin/ via an oauth2-proxy
# sidecar.  Python re-enforces authorization using identity headers injected
# by the proxy.  In local development (APP_ENV=local) a dev auth mode bypasses
# the proxy.

# OIDC provider credentials (provisioned from secrets in production).
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER_URL=
# OIDC_COOKIE_SECRET=

# Admin CSRF secret for double-submit token validation. Read by both the
# prototype listener and `services/api`, which requires it at startup.
# Generate with: openssl rand -hex 32
ADMIN_CSRF_SECRET=REPLACE_WITH_GENERATED_ADMIN_CSRF_SECRET
# Shared only by nginx and the admin backend, and required by `services/api` at
# startup: without it every admin route fails closed. Generate independently:
# openssl rand -hex 32
ADMIN_GATEWAY_TOKEN=REPLACE_WITH_GENERATED_ADMIN_GATEWAY_TOKEN

# Cross-origin widget CORS allowlist.  Comma-separated origins, never wildcard.
# Empty means same-origin only; the widget works without CORS when embedded
# on the same origin as the gateway.
WIDGET_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# SEC-003: explicit widget CORS origin allowlist. Never `*`.
# See WIDGET_ALLOWED_ORIGINS above.

# ---------------------------------------------------------------------------
# services/api
# ---------------------------------------------------------------------------
# The origins allowed to embed the widget. Unset falls back to localhost, which
# keeps development working and forces a deployment to name its origins.
CHAT_API_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CHAT_API_MAX_REQUEST_BYTES=65536
# The OpenAPI schema names every field and error code the API accepts. Useful
# while developing, a free map for anyone probing a public deployment.
CHAT_API_DOCS_ENABLED=true
CHAT_API_PORT=8080
# Bounded per API process. Capacity planning must multiply these values by every
# API/worker replica sharing Postgres.
CHAT_API_DATABASE_POOL_SIZE=5
CHAT_API_DATABASE_MAX_OVERFLOW=5
CHAT_API_DATABASE_POOL_TIMEOUT_SECONDS=5
CHAT_API_DATABASE_POOL_RECYCLE_SECONDS=1800
CHAT_ADMIN_PORT=8004
