# Local development configuration.
#
# Copy to `.env` (which is gitignored) and adjust:
#
#     make setup
#
# SEC-005: this file contains placeholders only. Real credentials never enter the
# repository, and no service falls back to a baked-in default for a secret — a
# missing required value must fail loudly at startup rather than silently running
# with a well-known password.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_DB=tenantchat
POSTGRES_USER=tenantchat
# Placeholder only. Replace it with output from: openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_POSTGRES_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tenantchat:REPLACE_WITH_GENERATED_POSTGRES_PASSWORD@localhost:5432/tenantchat
# Alembic alone reads this schema-owner URL. Local development may use the same
# login as DATABASE_URL; deployments must use distinct owner and application
# roles as documented in docs/runbooks/database-migrations.md.
DATABASE_MIGRATION_URL=postgresql+psycopg://tenantchat:REPLACE_WITH_GENERATED_POSTGRES_PASSWORD@localhost:5432/tenantchat

# ---------------------------------------------------------------------------
# Elasticsearch
# ---------------------------------------------------------------------------
# Security stays enabled locally (with TLS off for plain HTTP) so the retrieval
# code exercises the same authentication path it uses in Kubernetes. Running
# with `xpack.security.enabled=false` locally would leave that path untested.
ELASTICSEARCH_URL=http://localhost:9200
ES_USERNAME=elastic
# Placeholder only. Replace it with output from: openssl rand -hex 24
ES_PASSWORD=REPLACE_WITH_GENERATED_ELASTICSEARCH_PASSWORD
ELASTICSEARCH_PORT=9200
KNOWLEDGE_INDEX=tenant-knowledge-chunks
# REL-001 resilience envelope for the Elasticsearch client (all optional).
ES_TIMEOUT_SECONDS=30
ES_TOTAL_DEADLINE_SECONDS=120
ES_RETRY_MAX_ATTEMPTS=3
ES_CIRCUIT_FAILURE_THRESHOLD=5
ES_CIRCUIT_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------------------
# Embedding service
# ---------------------------------------------------------------------------
EMBEDDING_URL=http://localhost:8001
EMBEDDING_PORT=8001
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# Exact public Hub commit for the reviewed model files. The service also passes
# trust_remote_code=False; transformers 5.14.1 supports Qwen3 natively.
EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
# REL-001 resilience envelope for the embedding client (all optional).
EMBEDDING_TIMEOUT_SECONDS=300
EMBEDDING_TOTAL_DEADLINE_SECONDS=900
EMBEDDING_RETRY_MAX_ATTEMPTS=3
EMBEDDING_CIRCUIT_FAILURE_THRESHOLD=5
EMBEDDING_CIRCUIT_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------------------
# Language model
# ---------------------------------------------------------------------------
# Defaults to a local OpenAI-compatible server (LM Studio, Ollama, llama.cpp).
# ADR-0002 records why the demo targets a local provider: eval suites run
# hundreds of times during development and hosted inference would meter each one.
# A hosted provider is a configuration change, not a code change.
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=local-model
# An empty value is allowed in APP_ENV=local when the provider does not
# authenticate; APP_ENV=production rejects it and requires a real provider key.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
# REL-001 resilience envelope for the LLM client. Every knob is optional; the
# defaults below are the documented budgets.
LLM_TOTAL_DEADLINE_SECONDS=360
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_WRITE_TIMEOUT_SECONDS=60
LLM_POOL_TIMEOUT_SECONDS=10
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_SECONDS=0.25
LLM_RETRY_MAX_DELAY_SECONDS=2.0
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SECONDS=30

# ---------------------------------------------------------------------------
# Internal service authentication
# ---------------------------------------------------------------------------
# These four placeholders are independent credentials. Generate a different
# value for each with: openssl rand -hex 32
CHAT_TO_FINANCING_TOKEN=REPLACE_WITH_GENERATED_CHAT_TO_FINANCING_TOKEN
SEED_TO_INGESTION_TOKEN=REPLACE_WITH_GENERATED_SEED_TO_INGESTION_TOKEN
INGESTION_TO_EMBEDDING_TOKEN=REPLACE_WITH_GENERATED_INGESTION_TO_EMBEDDING_TOKEN
FINANCING_TO_EMBEDDING_TOKEN=REPLACE_WITH_GENERATED_FINANCING_TO_EMBEDDING_TOKEN

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# `make dev` runs Vite with hot reload and proxies /api to this backend, so the
# browser stays same-origin exactly as it is behind nginx. The default points
# at `make api` (services/api on 8080); point it elsewhere to develop against a
# different backend.
CHAT_DEV_BACKEND_ORIGIN=http://127.0.0.1:8080
CHAT_DEV_ADMIN_ORIGIN=http://127.0.0.1:8080
CHAT_DEV_PORT=5173
# `make web` runs the deployed nginx image against a backend on the host. The
# API image serves visitor and admin routes on one port, so both origins point
# at the same place here; Kubernetes routes them through the gateway's public
# and admin listeners.
CHAT_BACKEND_ORIGIN=http://host.docker.internal:8080
CHAT_ADMIN_ORIGIN=http://host.docker.internal:8080
# In compose there is no oauth2-proxy; `make api` has no dev auth mode, so the
# console's login needs a local auth proxy. In Kubernetes this is the
# oauth2-proxy Service.
AUTH_PROXY_ORIGIN=http://host.docker.internal:8080
WEB_PORT=8080

# ---------------------------------------------------------------------------
# Gateway authentication (SEC-001 single-origin gateway)
# ---------------------------------------------------------------------------
# The nginx gateway auth-gates /admin/ and /api/admin/ via an oauth2-proxy
# sidecar.  Python re-enforces authorization using identity headers injected
# by the proxy and fails closed without the gateway token and CSRF secret.

# OIDC provider credentials (provisioned from secrets in production).
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ISSUER_URL=
# OIDC_COOKIE_SECRET=

# Admin CSRF secret for double-submit token validation. Read by `services/api`,
# which requires it at startup.
# Generate with: openssl rand -hex 32
ADMIN_CSRF_SECRET=REPLACE_WITH_GENERATED_ADMIN_CSRF_SECRET
# Shared only by nginx and the admin backend, and required by `services/api` at
# startup: without it every admin route fails closed. Generate independently:
# openssl rand -hex 32
ADMIN_GATEWAY_TOKEN=REPLACE_WITH_GENERATED_ADMIN_GATEWAY_TOKEN

# SEC-001 local-development auth. When true, the API trusts the gateway identity
# headers directly (no gateway token required) and mints its own CSRF secret.
# The API refuses to start in this mode against a non-loopback DATABASE_URL, so
# a production deployment cannot accidentally run it. Leave unset (false) in
# every environment that is not a developer's laptop.
# CHAT_API_DEV_AUTH=true
# ---------------------------------------------------------------------------
# Visitor sessions (SEC-002 signed visitor credentials)
# ---------------------------------------------------------------------------
# HMAC key that signs the `tc.v1.*` visitor credentials issued by
# `POST /api/chat/session` and named by the `X-Visitor-Credential` header.
# Required by `services/api` at startup, like the admin credentials: without
# it no visitor route answers. At least 32 bytes; rotate by issuing a new key
# (old credentials stop being verifiable, so visitors start a fresh
# conversation after rotation).
# Generate with: openssl rand -base64 48
CHAT_API_VISITOR_CREDENTIAL_SIGNING_KEY=REPLACE_WITH_GENERATED_VISITOR_CREDENTIAL_SIGNING_KEY
# How long one credential stays valid without being reissued. Every
# credentialed response mints a fresh one, so active conversations never
# expire; an abandoned one becomes unusable after this window.
CHAT_API_VISITOR_CREDENTIAL_TTL_SECONDS=86400

# Cross-origin widget CORS allowlist.  Comma-separated origins, never wildcard.
# Empty means same-origin only; the widget works without CORS when embedded
# on the same origin as the gateway.
WIDGET_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# SEC-003: explicit widget CORS origin allowlist. Never `*`.
# See WIDGET_ALLOWED_ORIGINS above.

# ---------------------------------------------------------------------------
# services/api
# ---------------------------------------------------------------------------
# The origins allowed to embed the widget. Unset falls back to localhost, which
# keeps development working and forces a deployment to name its origins.
CHAT_API_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# SEC-003: the largest request body (bytes) the API will read, declared length
# or chunked. Unset defaults to 64 KiB.
CHAT_API_MAX_REQUEST_BYTES=65536
# SEC-003: the largest response (bytes) the API will emit; oversized responses
# are replaced by a 413 problem document. Unset defaults to 512 KiB.
CHAT_API_MAX_RESPONSE_BYTES=524288
# SEC-003: a session read serves at most this many most-recent messages.
# Unset defaults to 100.
CHAT_API_MAX_HISTORY_MESSAGES=100
# SEC-003: when true, unexpected errors publish their exception text to the
# caller. Leave unset in production — the text can carry connection strings or
# row data.
CHAT_API_DEBUG=false
# SEC-003: rate and concurrency budgets. Rates are fixed windows counted in
# Postgres across replicas; concurrency bounds in-flight requests per key per
# process. Unset uses the defaults shown.
CHAT_API_IP_RATE_LIMIT=600
CHAT_API_IP_CONCURRENCY=20
CHAT_API_TENANT_RATE_LIMIT=3000
CHAT_API_TENANT_CONCURRENCY=100
CHAT_API_SESSION_RATE_LIMIT=60
CHAT_API_SESSION_CONCURRENCY=5
CHAT_API_RATE_WINDOW_SECONDS=60
# The OpenAPI schema names every field and error code the API accepts. Useful
# while developing, a free map for anyone probing a public deployment.
CHAT_API_DOCS_ENABLED=true
CHAT_API_PORT=8080
# Bounded per API process. Capacity planning must multiply these values by every
# API/worker replica sharing Postgres.
CHAT_API_DATABASE_POOL_SIZE=5
CHAT_API_DATABASE_MAX_OVERFLOW=5
CHAT_API_DATABASE_POOL_TIMEOUT_SECONDS=5
CHAT_API_DATABASE_POOL_RECYCLE_SECONDS=1800
# The erasure and retention worker's login, named by PRIVACY_DATABASE_URL. It is
# a role holding DELETE on sessions and transcripts that the application role
# deliberately lacks; only the worker reads this variable, and the worker refuses
# to start without it. Safe default: unset, which leaves the API serving export
# and the deletion queue but never running erasure.
# PRIVACY_DATABASE_URL=postgresql+psycopg://tenantchat_privacy:REPLACE_WITH_GENERATED_POSTGRES_PASSWORD@localhost:5432/tenantchat
CHAT_API_PRIVACY_DATABASE_POOL_SIZE=2
CHAT_API_PRIVACY_DATABASE_MAX_OVERFLOW=2
# PRIV-002/ADR-0010: whether inference-trace content may be exported to a trace
# viewer. Disabled by default; when enabled, TRACE_CONTENT_EXPORT_ENDPOINT must
# name a viewer inside the cluster trust boundary (loopback, or a
# *.svc.cluster.local service behind the same admin authentication as the
# console), and the API refuses to start otherwise. The application itself
# never exports content — the collector is the fan-out point — so the only
# supported path is an operator consciously wiring a dedicated collector
# pipeline and the deployment environment together.
# TRACE_CONTENT_EXPORT=false
# TRACE_CONTENT_EXPORT_ENDPOINT=http://trace-viewer.observability.svc.cluster.local:4318
# REL-003 durable worker controls. The worker ID defaults to a hostname plus a
# random suffix; set it only when the runtime supplies a stable unique identity.
JOB_POLL_SECONDS=1
JOB_LEASE_SECONDS=60
JOB_BATCH_SIZE=10
JOB_BACKOFF_SECONDS=5
JOB_BACKOFF_CAP_SECONDS=3600
CHAT_ADMIN_PORT=8004

# ---------------------------------------------------------------------------
# Observability (OBS-001 structured logging)
# ---------------------------------------------------------------------------
# Bounds log volume: DEBUG is only for a deliberate, short-lived debugging
# session; production should run INFO or WARNING.
CHAT_API_LOG_LEVEL=INFO
# Structured JSON lines (ADR-0010 operational plane) instead of plain text.
# Every line carries timestamp, level, service, environment, request ID, trace
# ID, tenant pseudonym, and event.
CHAT_API_LOG_JSON=true
# Emit a per-request "request completed" access line with status and duration.
# Off by default: one line per request is real volume, and the other events
# already carry the correlation fields.
CHAT_API_LOG_ACCESS=false
# HMAC key tenant pseudonyms derive from, so a tenant ID never appears in a
# log line and the pseudonym cannot be reversed. Every service sharing a log
# store must share this key, or the same tenant gets a different pseudonym in
# each service's lines. Generate with: openssl rand -hex 32
CHAT_API_LOG_PSEUDONYM_KEY=
# Log retention is configured in the observability stack, not in the service:
# see the Loki table_manager retention knobs in k8s/observability-drilldown-fixes.yaml.
