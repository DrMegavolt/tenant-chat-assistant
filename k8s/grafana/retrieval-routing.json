{
  "title": "Retrieval & Routing Quality",
  "uid": "tenantchat-retrieval-routing",
  "description": "Routing decisions, retrieval verdicts, and citation validation \u2014 the quality classes that carry the 'quality by class, not volume' narrative.",
  "tags": [
    "tenantchat",
    "quality",
    "retrieval",
    "routing"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Routing Decisions \u2014 Rate by Intent",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "expr": "sum by (intent) (rate(tenantchat_routing_decisions_total[$__rate_interval]))",
          "legendFormat": "{{intent}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Routing Decision Classes",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(tenantchat_routing_decisions_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "options": {
        "displayLabels": [
          "name",
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right"
        }
      }
    },
    {
      "id": 3,
      "title": "Clarification Rate \u2014 Router Declining to Guess",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 4,
        "h": 3
      },
      "targets": [
        {
          "expr": "sum(rate(tenantchat_routing_decisions_total{outcome=\"clarify\"}[$__rate_interval])) / sum(rate(tenantchat_routing_decisions_total[$__rate_interval])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 5.0
              },
              {
                "color": "red",
                "value": 20.0
              }
            ]
          }
        }
      },
      "options": {
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Router Confidence Distribution",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(tenantchat_router_confidence_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(tenantchat_router_confidence_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "L5 dependency: metric tenantchat_router_confidence does not exist yet. Panel will resolve once L5 emits the histogram."
    },
    {
      "id": 5,
      "title": "Retrieval Runs \u2014 by Verdict",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (verdict) (rate(tenantchat_retrieval_runs_total[$__rate_interval]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        },
        {
          "expr": "sum by (status) (rate(tenantchat_retrieval_runs_total[$__rate_interval]))",
          "legendFormat": "status={{status}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sufficient"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "insufficient"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Citation Validation Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum by (verdict) (rate(tenantchat_citation_validation_total[$__rate_interval]))",
          "legendFormat": "{{verdict}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "valid"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "invalid"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Citation Invalid Rate",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 17,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(tenantchat_citation_validation_total{verdict=\"invalid\"}[$__rate_interval])) / sum(rate(tenantchat_citation_validation_total[$__rate_interval])) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 5.0
              },
              {
                "color": "red",
                "value": 15.0
              }
            ]
          }
        }
      },
      "options": {
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Retrieval \u2014 Candidates Total Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "rate(tenantchat_retrieval_candidates_total[$__rate_interval])",
          "legendFormat": "candidates/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "smooth",
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "title": "p95 Retrieval Latency by Status",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, status) (rate(tenantchat_retrieval_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
