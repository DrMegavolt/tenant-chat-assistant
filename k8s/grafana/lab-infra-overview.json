    {
      "id": 13,
      "title": "Restarts (24h) \u2014 top offenders",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "topk(10, sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[24h])) )",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Restart-bombing candidates; >3 in 30m fires the LabContainerRestartStorm monitor."
    },
    {
      "id": 14,
      "title": "Waiting containers (by reason)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "kube_pod_container_status_waiting_reason{reason!=\"\"}",
          "legendFormat": "{{namespace}}/{{pod}} \u2014 {{reason}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Empty when every container is either running or terminally failed."
    },
    {
      "id": 15,
      "title": "OOM kills (24h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_last_terminated_reason{reason=\"OOMKilled\"}[24h])) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 16,
      "title": "Deployments below desired replicas",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 6,
        "y": 57,
        "w": 18,
        "h": 8
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available < kube_deployment_spec_replicas",
          "legendFormat": "{{namespace}}/{{deployment}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Only deployments currently missing replicas appear. Empty table = every deployment at spec."
    },
    {
      "id": 17,
      "title": "PVC usage",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 65,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "kubelet_volume_stats_available_bytes / kubelet_volume_stats_capacity_bytes",
          "legendFormat": "{{namespace}}/{{persistentvolumeclaim}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Fills only for storage classes that report volume stats. The microk8s hostpath provisioner does not, so this stays empty in this lab \u2014 the LabPVCNearlyFull monitor shares the same blind spot (documented, not a data bug)."
    },
    {
      "id": 18,
      "title": "Reading this page",
      "type": "text",
      "gridPos": {
        "x": 12,
