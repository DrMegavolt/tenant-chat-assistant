      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"Lab.*\"}",
          "legendFormat": "{{alertname}} \u2014 {{alertstate}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Every Lab* monitor with its current state. An empty table means all monitors are OK; alerts route to the in-cluster Alertmanager."
