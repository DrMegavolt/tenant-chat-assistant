{
  "title": "Lab \u00b7 Services",
  "uid": "lab-services",
  "description": "The Datadog 'Service Catalog': one repeating tile block per deployment \u2014 status, requests/s, p95, error ratio, restarts, CPU, memory, probe \u2014 with a Monitors row at the bottom (GD-21/23/51). An outliers band above the catalog draws one line per service for traffic, p95, errors and restarts, so the odd one out is visible in a single panel. Tiles key off the lab:* recording rules, so a new deployment appears automatically.",
  "tags": [
    "lab",
    "services",
    "catalog",
    "apm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Data source"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(lab:deployment:restarts:increase1h, namespace)",
          "refId": "namespace-Variable-Query"
        },
        "definition": "label_values(lab:deployment:restarts:increase1h, namespace)",
        "label": "namespace",
        "hide": 0,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {}
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(lab:deployment:restarts:increase1h{namespace=~\"$namespace\"}, workload)",
          "refId": "service-Variable-Query"
        },
        "definition": "label_values(lab:deployment:restarts:increase1h{namespace=~\"$namespace\"}, workload)",
        "label": "service",
        "hide": 0,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "At a glance",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Deployments below spec",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(kube_deployment_status_replicas_available{namespace=~\"$namespace\"} < kube_deployment_spec_replicas{namespace=~\"$namespace\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
