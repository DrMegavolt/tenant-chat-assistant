{
  "title": "Lab \u00b7 Services",
  "uid": "lab-services",
  "description": "The Datadog 'Service Catalog': one sortable row per workload \u2014 replica health, requests/s, p95, error ratio, restarts, CPU and memory \u2014 with a Monitors row at the top (GD-21/23/51). An outliers band above the catalog draws one line per service for traffic, p95, errors and restarts, so the odd one out is visible in a single panel. Rows key off the lab:* recording rules, so a new deployment appears automatically.",
  "tags": [
    "lab",
    "services",
    "catalog",
    "apm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "lab"
      ],
      "targetBlank": false,
      "title": "Lab dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ],
    "time_options": [
      "5m",
      "15m",
      "1h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d",
      "30d"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "label": "Data source"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(lab:deployment:restarts:increase1h, namespace)",
          "refId": "namespace-Variable-Query"
        },
        "definition": "label_values(lab:deployment:restarts:increase1h, namespace)",
        "label": "namespace",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(lab:deployment:restarts:increase1h{namespace=~\"$namespace\"}, workload)",
          "refId": "service-Variable-Query"
        },
        "definition": "label_values(lab:deployment:restarts:increase1h{namespace=~\"$namespace\"}, workload)",
        "label": "service",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "title": "At a glance",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 1,
      "title": "Deployments below spec",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(kube_deployment_status_replicas_available{namespace=~\"$namespace\"} < kube_deployment_spec_replicas{namespace=~\"$namespace\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Monitors firing",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(ALERTS{alertname=~\"Lab.*\", alertstate=\"firing\"}) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "title": "Probes failing",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(probe_success{job=~\"lab-http(-redirect)?-probes\"} == 0) or vector(0)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Services in view",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(lab:deployment:cpu:rate5m{namespace=~\"$namespace\"})",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        }
      },
      "options": {
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "title": "Monitors (lab-monitors PrometheusRule \u2014 GD-51 parity)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "ALERTS{alertname=~\"Lab.*\"}",
          "legendFormat": "{{alertname}} \u2014 {{alertstate}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Every Lab* monitor with its current state. An empty table means all monitors are OK; alerts route to the in-cluster Alertmanager."
    },
    {
      "id": 102,
      "title": "Outliers at a glance \u2014 one line per service",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 120,
      "title": "Requests/s \u2014 all services",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "lab:service:http:rps:rate5m{namespace=~\"$namespace\", service=~\"$service\"} or lab:gateway:service:rps:rate5m{namespace=~\"$namespace\", service=~\"$service\"}",
          "legendFormat": "{{namespace}}/{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Native OTel line where the service is instrumented, Traefik edge line otherwise; the `or` dedupes so each service draws once."
    },
    {
      "id": 121,
      "title": "p95 latency \u2014 all services",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "lab:service:http:p95:rate5m{namespace=~\"$namespace\", service=~\"$service\"} or lab:gateway:service:p95:rate5m{namespace=~\"$namespace\", service=~\"$service\"}",
          "legendFormat": "{{namespace}}/{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 2.0
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Same 0.5 s / 2 s guide lines as the p95 tiles below \u2014 the outlier service and the offending spike show up without opening the drilldown."
    },
    {
      "id": 122,
      "title": "Error ratio (5xx) \u2014 all services",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "lab:gateway:service:error_ratio:rate5m{namespace=~\"$namespace\", service=~\"$service\"}",
          "legendFormat": "{{namespace}}/{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "5xx share at the Traefik edge, one line per service; the 5 % monitor threshold is drawn."
    },
    {
      "id": 123,
      "title": "Restarts (1h) \u2014 all deployments",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "expr": "lab:deployment:restarts:increase1h{namespace=~\"$namespace\", workload=~\"$service\"}",
          "legendFormat": "{{namespace}}/{{workload}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green"
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Restart spikes per deployment; same 1 / 4 thresholds as the tiles below."
    },
    {
      "id": 101,
      "title": "Service catalog",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 110,
      "title": "Service catalog \u2014 health, traffic and saturation",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 17
      },
      "targets": [
        {
          "expr": "label_replace(kube_deployment_status_replicas_available{namespace=~\"$namespace\", deployment=~\"$service\"} / kube_deployment_spec_replicas{namespace=~\"$namespace\", deployment=~\"$service\"}, \"service\", \"$1\", \"deployment\", \"(.*)\")",
          "legendFormat": "replica health",
          "refId": "A",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "lab:service:http:rps:rate5m{namespace=~\"$namespace\", service=~\"$service\"} or lab:gateway:service:rps:rate5m{namespace=~\"$namespace\", service=~\"$service\"}",
          "legendFormat": "requests/s",
          "refId": "B",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "lab:service:http:p95:rate5m{namespace=~\"$namespace\", service=~\"$service\"} or lab:gateway:service:p95:rate5m{namespace=~\"$namespace\", service=~\"$service\"}",
          "legendFormat": "p95",
          "refId": "C",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "lab:gateway:service:error_ratio:rate5m{namespace=~\"$namespace\", service=~\"$service\"}",
          "legendFormat": "5xx ratio",
          "refId": "D",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "label_replace(lab:deployment:restarts:increase1h{namespace=~\"$namespace\", workload=~\"$service\"}, \"service\", \"$1\", \"workload\", \"(.*)\")",
          "legendFormat": "restarts 1h",
          "refId": "E",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "label_replace(lab:deployment:cpu:rate5m{namespace=~\"$namespace\", workload=~\"$service\"}, \"service\", \"$1\", \"workload\", \"(.*)\")",
          "legendFormat": "cpu cores",
          "refId": "F",
          "instant": true,
          "format": "table"
        },
        {
          "expr": "label_replace(lab:deployment:memory:workingset{namespace=~\"$namespace\", workload=~\"$service\"}, \"service\", \"$1\", \"workload\", \"(.*)\")",
          "legendFormat": "memory",
          "refId": "G",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open service drilldown",
                    "url": "/d/lab-service-drilldown?var-namespace=${__data.fields.namespace}&var-service=${__value.raw}&from=${__from}&to=${__to}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Replicas"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.5
                    },
                    {
                      "color": "red",
                      "value": 2
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.01
                    },
                    {
                      "color": "red",
                      "value": 0.05
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "One row per workload. Click the service name to open its drilldown with the same time range. N/A means that signal is not emitted for that workload; it does not mean zero.",
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "deployment": true,
              "workload": true
            },
            "indexByName": {
              "namespace": 0,
              "service": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7,
              "Value #G": 8
            },
            "renameByName": {
              "Value #A": "Replicas",
              "Value #B": "Requests/s",
              "Value #C": "p95",
              "Value #D": "5xx",
              "Value #E": "Restarts 1h",
              "Value #F": "CPU cores",
              "Value #G": "Memory"
            }
          }
        }
      ]
    }
  ]
}
