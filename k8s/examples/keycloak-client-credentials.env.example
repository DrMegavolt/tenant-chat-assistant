# Secret keycloak-client-credentials in the identity namespace.
#
# The same value as `clientSecret` in the llm-chat `oidc-credentials` Secret:
# Keycloak stores one side of the confidential client's credential and
# oauth2-proxy presents the other. Rotating means updating both Secrets and
# re-running the realm bootstrap Job (`helm upgrade`), then restarting
# oauth2-proxy.
#
# Generate with `openssl rand -hex 32`.
clientSecret=REPLACE_WITH_OIDC_CLIENT_SECRET
