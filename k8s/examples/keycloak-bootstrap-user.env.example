# Secret keycloak-bootstrap-user in the identity namespace.
#
# The first operator account in the tenantchat realm, placed in the group named
# by `bootstrapUser.group`. Without a member of one of the four role groups the
# realm authenticates nobody usefully: the gateway maps an unrecognized group
# set to no role and Python fails closed.
#
# The password is temporary by default — Keycloak forces a change at first
# login — so it only has to survive the handover. Generate with
# `openssl rand -hex 16`.
username=REPLACE_WITH_BOOTSTRAP_USERNAME
password=REPLACE_WITH_BOOTSTRAP_PASSWORD
email=replace-with-operator@example.invalid
