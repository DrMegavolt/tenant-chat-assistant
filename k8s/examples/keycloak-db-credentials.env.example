# Secret keycloak-db-credentials in the identity namespace. Read by both the
# embedded Postgres StatefulSet and Keycloak's JDBC configuration, so one
# rotation covers both sides. This database is Keycloak's alone; it is not the
# application database in llm-chat.
#
# Generate the password with `openssl rand -hex 24`.
username=REPLACE_WITH_KEYCLOAK_DB_USERNAME
password=REPLACE_WITH_KEYCLOAK_DB_PASSWORD
