# Copy this file to .local/k8s/demo-access.env and replace the example URLs.
# The destination is gitignored. Do not put passwords or tokens here; the
# preparation helper reads those directly from Kubernetes Secrets.

VISITOR_URL=https://chat.example.invalid/
TENANTCHAT_ADMIN_URL=https://chat.example.invalid/admin/
KEYCLOAK_URL=https://auth.example.invalid
GRAFANA_URL=https://grafana.example.invalid
PROMETHEUS_URL=https://prometheus.example.invalid
TEMPO_URL=https://tempo.example.invalid
PHOENIX_URL=https://phoenix.example.invalid
MLFLOW_URL=https://mlflow.example.invalid
KAFKA_UI_URL=https://kafka-ui.example.invalid
KUBERNETES_DASHBOARD_URL=https://kubernetes.example.invalid
KIBANA_URL=https://kibana.example.invalid

# These defaults match the manifests shipped by this repository. Change only
# the values that differ in your deployment.
IDENTITY_NAMESPACE=identity
KEYCLOAK_BOOTSTRAP_RESOURCE=keycloak-bootstrap-user
KEYCLOAK_ADMIN_CREDENTIAL_RESOURCE=keycloak-admin-credentials
KEYCLOAK_POD_SELECTOR=app.kubernetes.io/name=keycloak,app.kubernetes.io/instance=keycloak
KEYCLOAK_REALM=tenantchat
TENANTCHAT_OPERATOR_GROUP=platform_admin

OBSERVABILITY_NAMESPACE=observability
GRAFANA_CREDENTIAL_RESOURCE=kube-prom-stack-grafana
PHOENIX_CREDENTIAL_RESOURCE=phoenix-secret

APPLICATION_NAMESPACE=llm-chat
ELASTIC_CREDENTIAL_RESOURCE=elastic-credentials
