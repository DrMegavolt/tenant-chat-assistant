# Secret keycloak-admin-credentials in the identity namespace.
#
# Keycloak creates this master-realm administrator on first start only and
# ignores the values afterwards. The realm bootstrap Job reuses it to set the
# gateway client's secret and to seed the first operator account.
#
# Generate with `openssl rand -hex 24`.
username=REPLACE_WITH_KEYCLOAK_ADMIN_USERNAME
password=REPLACE_WITH_KEYCLOAK_ADMIN_PASSWORD
