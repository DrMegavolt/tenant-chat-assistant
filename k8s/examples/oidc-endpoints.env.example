# ConfigMap oidc-endpoints in llm-chat. oauth2-proxy runs with OIDC discovery
# disabled, so each endpoint is stated explicitly.
#
# loginUrl and redirectUrl are browser-facing and must be reachable from the
# user's machine. redeemUrl, jwksUrl, and profileUrl are backchannel calls made
# by oauth2-proxy and stay on the in-cluster Service, so they use plain HTTP and
# do not depend on the cluster resolving or trusting the public hostname.
#
# Keycloak issues tokens whose `iss` is derived from KC_HOSTNAME, which the
# chart sets to keycloak.publicUrl. That value must equal the host in loginUrl
# and the issuerUrl in the oidc-credentials Secret.
loginUrl=https://replace-with-keycloak-host.invalid/realms/tenantchat/protocol/openid-connect/auth
redeemUrl=http://keycloak.identity.svc.cluster.local:8080/realms/tenantchat/protocol/openid-connect/token
jwksUrl=http://keycloak.identity.svc.cluster.local:8080/realms/tenantchat/protocol/openid-connect/certs
profileUrl=http://keycloak.identity.svc.cluster.local:8080/realms/tenantchat/protocol/openid-connect/userinfo
redirectUrl=https://replace-with-gateway-host.invalid/oauth2/callback
