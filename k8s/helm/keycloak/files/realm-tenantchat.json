{
  "realm": "{{ .Values.keycloak.realm }}",
  "displayName": "TenantChat",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": {{ .Values.realm.accessTokenLifespan }},
  "ssoSessionIdleTimeout": {{ .Values.realm.ssoSessionIdleTimeout }},
  "ssoSessionMaxLifespan": {{ .Values.realm.ssoSessionMaxLifespan }},
  "offlineSessionIdleTimeout": 2592000,
  "groups": [
{{- range $index, $group := .Values.realm.groups }}
    {{ if $index }},{{ end }}{ "name": "{{ $group }}", "path": "/{{ $group }}" }
{{- end }}
  ],
{{/*
A realm representation carrying `clientScopes` is authoritative: Keycloak
assigns exactly that list and skips the built-in scopes it would otherwise
create, so declaring the `groups` scope here silently deleted `profile`,
`email`, `roles`, `web-origins`, and `basic`. The gateway then requested
`openid profile email groups` and Keycloak refused the whole authorization
request with `invalid_scope`, making /admin/ unreachable. The key is therefore
absent, and the bootstrap Job adds `groups` to the realm Keycloak built.
*/}}
  "clients": [
    {
      "clientId": "{{ .Values.realm.clientId }}",
      "name": "TenantChat admin gateway",
      "description": "Confidential client for the oauth2-proxy sidecar in front of /admin/",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": ["{{ include "tenantchat.keycloak.gatewayUrl" . }}/oauth2/callback"],
      "webOrigins": ["{{ include "tenantchat.keycloak.gatewayUrl" . }}"],
      "attributes": {
        "post.logout.redirect.uris": "{{ include "tenantchat.keycloak.gatewayUrl" . }}/*",
        "pkce.code.challenge.method": "S256"
      },
{{/*
`groups` is missing from this list on purpose: it does not exist yet at import
time, and Keycloak drops an unresolvable scope name here without failing the
import. The bootstrap Job creates it and attaches it as a default scope.
*/}}
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles",
        "web-origins"
      ],
      "optionalClientScopes": []
    }
  ]
}
