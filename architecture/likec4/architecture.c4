specification {
  tag deployment

  element person {
    style {
      shape person
      color blue
    }
  }

  element softwareSystem {
    style {
      color blue
    }
  }

  element externalSystem {
    style {
      color muted
    }
  }

  element application {
    style {
      color sky
    }
  }

  element userInterface {
    style {
      shape browser
      color green
    }
  }

  element service {
    style {
      color green
    }
  }

  element component {
    style {
      color sky
    }
  }

  element worker {
    style {
      color amber
    }
  }

  element database {
    style {
      shape storage
      color amber
    }
  }

  element queue {
    style {
      shape queue
      color amber
    }
  }

  relationship request {
    title 'Request'
  }

  relationship command {
    title 'Command'
  }

  relationship query {
    title 'Query'
  }

  relationship async {
    title 'Asynchronous'
    line dotted
  }

  relationship observe {
    title 'Telemetry'
    line dotted
    color muted
  }

  relationship deploymentFlow {
    #deployment
    title 'Deployment flow'
    color blue
  }

  deploymentNode environment

  deploymentNode kubernetes {
    style {
      color blue
      icon tech:kubernetes
    }
  }

  deploymentNode namespace

  deploymentNode workload {
    style {
      color sky
      multiple true
    }
  }

  deploymentNode storage {
    style {
      color amber
    }
  }

  deploymentNode external {
    style {
      color muted
    }
  }
}

model {
  visitor = person 'Visitor' {
    description 'Uses the embedded chat widget'
  }

  operator = person 'Operator' {
    description 'Reviews chats, knowledge, handoffs, jobs, access, and AI turns'
  }

  platformOperator = person 'Platform Operator' {
    description 'Deploys the system and monitors its health'
  }

  identityProvider = externalSystem 'Keycloak' {
    technology 'OIDC'
    description 'Authenticates operators and supplies group membership to oauth2-proxy'
  }

  chatModel = externalSystem 'OpenAI-compatible Chat Model' {
    description 'Generates assistant responses and tool calls. The repository deployment points to a separately operated provider.'
  }

  operationalTelemetry = externalSystem 'Operational Observability Stack' {
    technology 'OpenTelemetry, Prometheus, Grafana, Loki, Tempo'
    description 'Stores content-free logs, metrics, and traces'
  }

  platform = softwareSystem 'Tenant Chat Assistant' {
    description 'Multi-tenant RAG, booking, lead, handoff, and answer-review demo'

    web = application 'Web Image' {
      technology 'nginx, React, Vite'
      description 'One image containing the public site, widget bundle, operator console, and same-origin gateway'

      gateway = service 'nginx Gateway' {
        description 'Serves assets, applies the visitor CORS allowlist, auth-gates admin paths, and proxies the API'
      }

      widget = userInterface 'Visitor Widget' {
        technology 'React in a shadow root'
        description 'Chat, citations, consent, booking confirmation, feedback, and handoff status'
      }

      admin = userInterface 'Operator Console' {
        technology 'React'
        description 'Chat, handoff, review, knowledge, trace, access, and audit views'
      }
    }

    authProxy = service 'oauth2-proxy' {
      description 'Completes OIDC login and returns authenticated identity headers to nginx'
    }

    api = application 'Application API' {
      technology 'FastAPI'
      description 'One process serving visitor, operator, health, and metrics routes'

      visitorRoutes = service 'Visitor API' {
        description 'Tenant configuration, signed sessions, chat turns, consent, confirmation, feedback, and source views'
      }

      adminRoutes = service 'Admin API' {
        description 'Tenant-scoped operations for chats, handoffs, knowledge, reviews, traces, jobs, privacy, and access'
      }

      identity = component 'Identity and Session Security' {
        description 'Validates gateway identity, tenant membership, CSRF tokens, and signed visitor credentials'
      }

      orchestration = component 'LangGraph Dispatcher' {
        technology 'dispatch@3 with a PostgreSQL checkpointer'
        description 'Nine-node route, model, tool, confirmation, commit, escalation, and finalize graph'
      }

      router = component 'Intent Router and Agent Registry' {
        description 'Routes to seven versioned agents with closed tool allowlists'
      }

      prompts = component 'Prompt Assembly' {
        description 'Builds versioned prompts with explicit trusted and untrusted sections'
      }

      toolDispatcher = component 'Tool Dispatcher' {
        description 'Executes service-area, availability, booking, lead, and handoff tools through typed domain commands'
      }

      domain = component 'Deterministic Domain Services' {
        technology 'packages/core'
        description 'Owns policy, validation, consent, state transitions, idempotency, and business rules without framework dependencies'
      }

      persistence = component 'PostgreSQL Adapters' {
        technology 'SQLAlchemy and psycopg'
        description 'Stores tenant-qualified conversations, actions, jobs, knowledge metadata, audit events, and turn records'
      }

      knowledge = component 'Knowledge and Retrieval' {
        description 'Manages document versions and performs tenant-filtered hybrid retrieval, evidence selection, and citation validation'
      }

      provenance = component 'Answer Provenance' {
        description 'Records routing, candidates, prompts, model rounds, validation, diagnosis, and executed graph events'
      }
    }

    jobWorker = application 'Durable Job Worker' {
      technology 'API image, separate command'
      description 'Leases PostgreSQL jobs and handles ingestion and privacy deletion with at-least-once execution'

      leases = queue 'PostgreSQL Job Queue' {
        description 'Tenant-qualified jobs, retries, leases, and dead-letter state'
      }

      ingestion = worker 'Ingestion Handler' {
        description 'Scans, parses, chunks, embeds, indexes, and activates approved document versions'
      }

      privacy = worker 'Privacy Handler' {
        description 'Executes approved export, retention, and deletion work with the dedicated database role'
      }
    }

    embedding = application 'Embedding Service' {
      technology 'FastAPI and pinned Qwen3 embedding model'
      description 'Creates document and query embeddings over authenticated internal routes'
    }

    releaseJobs = application 'Release Jobs' {
      description 'Runs Alembic, creates LangGraph checkpoint tables, and seeds governed demo knowledge'
    }

    postgres = database 'PostgreSQL' {
      description 'System of record for application data, durable jobs, inference records, and LangGraph checkpoints'
    }

    elasticsearch = database 'Elasticsearch' {
      description 'Rebuildable tenant-scoped lexical and vector search index'
    }

    uploads = database 'Knowledge Upload Storage' {
      description 'Versioned uploaded source files. The repository deployment uses a persistent volume.'
    }

    kibana = userInterface 'Kibana' {
      description 'Internal Elasticsearch inspection UI in the reference deployment'
    }
  }

  visitor -[request]-> platform.web.widget 'Chats'
  operator -[request]-> platform.web.admin 'Operates the demo'
  platformOperator -[request]-> operationalTelemetry 'Monitors the deployment'

  platform.web.widget -[request]-> platform.web.gateway 'Visitor requests'
  platform.web.admin -[request]-> platform.web.gateway 'Admin requests'
  platform.web.gateway -[request]-> platform.authProxy 'Checks admin authentication'
  platform.authProxy -[request]-> identityProvider 'OIDC login and validation'
  platform.web.gateway -[request]-> platform.api.visitorRoutes 'Proxies public API paths'
  platform.web.gateway -[request]-> platform.api.adminRoutes 'Proxies authenticated admin paths'

  platform.api.visitorRoutes -[request]-> platform.api.identity 'Validates signed visitor identity'
  platform.api.adminRoutes -[request]-> platform.api.identity 'Checks operator and tenant access'
  platform.api.visitorRoutes -[request]-> platform.api.orchestration 'Runs a turn'
  platform.api.adminRoutes -[command]-> platform.api.knowledge 'Manages knowledge versions'
  platform.api.adminRoutes -[query]-> platform.api.provenance 'Reads and replays turn records'
  platform.api.adminRoutes -[command]-> platform.api.domain 'Operates handoffs, reviews, privacy, and access'

  platform.api.orchestration -[request]-> platform.api.router 'Chooses an intent and registered agent'
  platform.api.orchestration -[request]-> platform.api.prompts 'Assembles each model request'
  platform.api.orchestration -[request]-> chatModel 'Calls the configured provider'
  platform.api.orchestration -[command]-> platform.api.toolDispatcher 'Runs an allowed tool'
  platform.api.orchestration -[query]-> platform.api.knowledge 'Retrieves evidence for general answers'
  platform.api.orchestration -[command]-> platform.api.provenance 'Records the turn'

  platform.api.toolDispatcher -[command]-> platform.api.domain 'Parses and authorizes typed commands'
  platform.api.domain -[command]-> platform.api.persistence 'Commits business records and idempotency keys'
  platform.api.knowledge -[query]-> platform.elasticsearch 'Runs hybrid search'
  platform.api.knowledge -[request]-> platform.embedding 'Embeds visitor queries'
  platform.api.knowledge -[query]-> platform.api.persistence 'Checks published versions and indexing state'
  platform.api.provenance -[command]-> platform.api.persistence 'Appends content-bearing turn records'
  platform.api.persistence -[command]-> platform.postgres 'Reads and writes application data'

  platform.jobWorker.leases -[query]-> platform.postgres 'Claims due work'
  platform.jobWorker.ingestion -[query]-> platform.uploads 'Reads uploaded sources'
  platform.jobWorker.ingestion -[request]-> platform.embedding 'Embeds chunks'
  platform.jobWorker.ingestion -[command]-> platform.elasticsearch 'Indexes one generation'
  platform.jobWorker.ingestion -[command]-> platform.postgres 'Updates lifecycle and job state'
  platform.jobWorker.privacy -[command]-> platform.postgres 'Applies retention and deletion'
  platform.api.knowledge -[command]-> platform.uploads 'Stores uploaded sources'
  platform.api.knowledge -[async]-> platform.jobWorker.leases 'Enqueues ingestion'
  platform.api.domain -[async]-> platform.jobWorker.leases 'Enqueues privacy work'

  platform.releaseJobs -[command]-> platform.postgres 'Applies migrations and creates checkpoint tables'
  platform.releaseJobs -[request]-> platform.api.adminRoutes 'Seeds knowledge through the authenticated lifecycle'
  platform.kibana -[query]-> platform.elasticsearch 'Inspects the search index'

  platform.api -[observe]-> operationalTelemetry 'Emits content-free telemetry'
  platform.jobWorker -[observe]-> operationalTelemetry 'Emits content-free telemetry'
  platform.embedding -[observe]-> operationalTelemetry 'Emits content-free telemetry'
}

deployment {
  environment repository 'Repository Kubernetes Deployment' {
    kubernetes microk8s 'MicroK8s Cluster' {
      namespace appNamespace 'llm-chat' {
        workload webPod 'web Deployment' {
          web = instanceOf platform.web
        }

        workload authPod 'oauth2-proxy Deployment' {
          auth = instanceOf platform.authProxy
        }

        workload apiPod 'chat-backend Deployment' {
          api = instanceOf platform.api
        }

        workload workerPod 'job-worker Deployment' {
          worker = instanceOf platform.jobWorker
        }

        workload embeddingPod 'embedding-service Deployment' {
          embedding = instanceOf platform.embedding
        }

        workload postgresPod 'postgres StatefulSet' {
          postgres = instanceOf platform.postgres
        }

        workload elasticsearchPod 'elasticsearch StatefulSet' {
          elasticsearch = instanceOf platform.elasticsearch
        }

        workload kibanaPod 'kibana Deployment' {
          kibana = instanceOf platform.kibana
        }

        workload releasePod 'Migration and Seed Jobs' {
          releases = instanceOf platform.releaseJobs
        }

        storage uploadsPvc 'knowledge-upload-storage PVC' {
          uploads = instanceOf platform.uploads
        }
      }

      namespace identityNamespace 'identity' {
        workload keycloakPod 'Keycloak Helm release' {
          keycloak = instanceOf identityProvider
        }
      }

      namespace observabilityNamespace 'observability' {
        workload telemetryPods 'Collector and observability stack' {
          telemetry = instanceOf operationalTelemetry
        }
      }
    }

    external inferenceHost 'Separately operated model host' {
      model = instanceOf chatModel
    }

    microk8s.appNamespace.webPod.web -[deploymentFlow]-> microk8s.appNamespace.authPod.auth 'Authenticates admin requests'
    microk8s.appNamespace.authPod.auth -[deploymentFlow]-> microk8s.identityNamespace.keycloakPod.keycloak 'Uses OIDC'
    microk8s.appNamespace.webPod.web -[deploymentFlow]-> microk8s.appNamespace.apiPod.api 'Proxies API requests'
    microk8s.appNamespace.apiPod.api -[deploymentFlow]-> microk8s.appNamespace.postgresPod.postgres 'Reads and writes state'
    microk8s.appNamespace.apiPod.api -[deploymentFlow]-> microk8s.appNamespace.elasticsearchPod.elasticsearch 'Retrieves evidence'
    microk8s.appNamespace.apiPod.api -[deploymentFlow]-> microk8s.appNamespace.embeddingPod.embedding 'Embeds queries'
    microk8s.appNamespace.apiPod.api -[deploymentFlow]-> inferenceHost.model 'Calls the chat model'
    microk8s.appNamespace.workerPod.worker -[deploymentFlow]-> microk8s.appNamespace.postgresPod.postgres 'Claims and updates jobs'
    microk8s.appNamespace.workerPod.worker -[deploymentFlow]-> microk8s.appNamespace.elasticsearchPod.elasticsearch 'Indexes chunks'
    microk8s.appNamespace.workerPod.worker -[deploymentFlow]-> microk8s.appNamespace.embeddingPod.embedding 'Embeds chunks'
    microk8s.appNamespace.workerPod.worker -[deploymentFlow]-> microk8s.appNamespace.uploadsPvc.uploads 'Reads source files'
    microk8s.appNamespace.apiPod.api -[deploymentFlow]-> microk8s.appNamespace.uploadsPvc.uploads 'Stores source files'
    microk8s.appNamespace.kibanaPod.kibana -[deploymentFlow]-> microk8s.appNamespace.elasticsearchPod.elasticsearch 'Inspects the index'
    microk8s.appNamespace.releasePod.releases -[deploymentFlow]-> microk8s.appNamespace.postgresPod.postgres 'Applies schema changes'
    microk8s.appNamespace.apiPod.api -[deploymentFlow]-> microk8s.observabilityNamespace.telemetryPods.telemetry 'Exports telemetry'
    microk8s.appNamespace.workerPod.worker -[deploymentFlow]-> microk8s.observabilityNamespace.telemetryPods.telemetry 'Exports telemetry'
    microk8s.appNamespace.embeddingPod.embedding -[deploymentFlow]-> microk8s.observabilityNamespace.telemetryPods.telemetry 'Exports metrics'
  }
}

views {
  view index {
    title '01 / System Context'
    description 'People and external systems connected to the implementation in this repository.'

    include visitor
    include operator
    include platformOperator
    include platform
    include identityProvider
    include chatModel
    include operationalTelemetry
  }

  view platform_overview {
    title '02 / Current Platform'
    description 'Runtime boundaries in main. The FastAPI process is a modular monolith; the worker, embedding service, and web gateway run separately.'

    include visitor
    include operator
    include platform.*
    include identityProvider
    include chatModel
    include operationalTelemetry
  }

  view agent_runtime {
    title '03 / Agent Runtime'
    description 'The implemented dispatch@3 graph. LangGraph coordinates work while domain services authorize and commit every business effect.'

    include platform.api.visitorRoutes
    include platform.api.identity
    include platform.api.orchestration
    include platform.api.router
    include platform.api.prompts
    include platform.api.toolDispatcher
    include platform.api.domain
    include platform.api.persistence
    include platform.api.knowledge
    include platform.api.provenance
    include platform.postgres
    include platform.elasticsearch
    include platform.embedding
    include chatModel
  }

  view knowledge_pipeline {
    title '04 / Knowledge and Retrieval'
    description 'An approved upload becomes one indexed generation. The answer path retrieves only published tenant content and validates its evidence.'

    include operator
    include platform.web.admin
    include platform.api.adminRoutes
    include platform.api.knowledge
    include platform.api.persistence
    include platform.jobWorker.*
    include platform.embedding
    include platform.postgres
    include platform.elasticsearch
    include platform.uploads
  }

  view business_actions {
    title '05 / Business Actions'
    description 'Bookings, leads, and handoffs are validated and committed locally. External calendar, CRM, and notification integrations are not implemented.'

    include platform.api.visitorRoutes
    include platform.api.orchestration
    include platform.api.toolDispatcher
    include platform.api.domain
    include platform.api.persistence
    include platform.jobWorker.leases
    include platform.postgres
  }

  view answer_provenance {
    title '06 / Answer Provenance'
    description 'The operator explorer reads the same Postgres turn record that captured routing, retrieval, prompts, model rounds, verdicts, diagnoses, and graph events.'

    include operator
    include platform.web.admin
    include platform.api.adminRoutes
    include platform.api.orchestration
    include platform.api.router
    include platform.api.prompts
    include platform.api.knowledge
    include platform.api.provenance
    include platform.api.persistence
    include platform.postgres
    include operationalTelemetry
  }

  deployment view production_deployment {
    title '07 / Repository Kubernetes Deployment'
    description 'The single-replica MicroK8s reference deployment tracked under k8s/. It is a demo topology, not a highly available production design.'

    include repository.**
    exclude * -> * where tag is not #deployment
  }
}
